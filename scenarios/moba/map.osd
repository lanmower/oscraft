# Map for the moba scenario: two sides, three lanes, a tower per side per lane, one base per side.
# grid(fill=1) starts every cell blocked; paint(..., 0) opens a lane. Half-open rectangles.
grid(40, 24, cell_milli=1000, fill=1)
paint(2, 3, 38, 6, 0)
paint(2, 11, 38, 14, 0)
paint(2, 19, 38, 22, 0)
paint(2, 3, 4, 22, 0)
paint(36, 3, 38, 22, 0)
# Elevation: a flat base level and a raised plateau around the middle. Doodads sit between the lanes.
height_step(500)
paint_height(0, 0, 40, 24, 1)
paint_height(16, 7, 24, 17, 6)
doodad(1, "rock", 9000, 8500)
doodad(2, "tree", 15000, 16500, rotation=250)
doodad(3, "crystal", 22000, 8500)
doodad(4, "debris", 27000, 16500, rotation=120)
doodad(5, "tree", 33000, 8500, rotation=60)
doodad(6, "rock", 12000, 16500)
doodad(7, "crystal", 18000, 8500)
start(0, 4000, 12000)
start(1, 36000, 12000)
# Bases: structures that spawn creeps on a timer and that the win trigger watches.
spawn("base", 0, 4000, 12000)
spawn("base", 1, 36000, 12000)
# One hero per side and one worker per side.
spawn("hero", 0, 6000, 12000)
spawn("hero", 1, 34000, 12000)
spawn("tender", 0, 6000, 12500)
spawn("tender", 1, 34000, 12500)
# Lane north (y 3..5): a tower per side with hit points, one opening creep per side.
spawn("tower", 0, 12000, 4500)
spawn("tower", 1, 28000, 4500)
spawn("creep", 0, 10000, 4500)
spawn("creep", 1, 30000, 4500)
# Lane middle (y 11..13).
spawn("tower", 0, 12000, 12500)
spawn("tower", 1, 28000, 12500)
spawn("creep", 0, 10000, 12500)
spawn("creep", 1, 30000, 12500)
# Lane south (y 19..21).
spawn("tower", 0, 12000, 20500)
spawn("tower", 1, 28000, 20500)
spawn("creep", 0, 10000, 20500)
spawn("creep", 1, 30000, 20500)
# One objective per side in the middle lane, appended last so earlier unit indices hold.
spawn("objective", 0, 14000, 12500)
spawn("objective", 1, 26000, 12500)
