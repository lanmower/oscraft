# Map for the moba scenario at Dota scale: 64 x 60 cells, three lanes (top, mid, bottom) between two bases,
# a river (a walkable ford at the low level) between the teams, four jungle camp areas, shops and fountains at each base.
# grid(fill=1) starts every cell blocked; paint(..., 0) opens walkable terrain. Half-open rectangles.
grid(64, 60, cell_milli=1000, fill=1)
# Three lanes across the map, each one full width.
paint(2, 7, 62, 10, 0)
paint(2, 29, 62, 32, 0)
paint(2, 51, 62, 54, 0)
# Base pads at each end of the middle lane, joined to all three lanes by two connector columns.
paint(2, 27, 10, 35, 0)
paint(54, 27, 62, 35, 0)
paint(4, 7, 10, 54, 0)
paint(54, 7, 60, 54, 0)
# River: a walkable ford down the middle, so lanes cross it.
paint(30, 0, 34, 60, 0)
# Jungle camp areas: two per side, between the top and middle lane and between the middle and bottom lane.
paint(12, 10, 28, 29, 0)
paint(12, 32, 28, 51, 0)
paint(36, 10, 52, 29, 0)
paint(36, 32, 52, 51, 0)
# Elevation: the field is level 1, the river is level 0, the jungle is raised to level 3.
height_step(1000)
paint_height(0, 0, 64, 60, 1)
paint_height(30, 0, 34, 60, 0)
paint_height(12, 10, 28, 29, 3)
paint_height(12, 32, 28, 51, 3)
paint_height(36, 10, 52, 29, 3)
paint_height(36, 32, 52, 51, 3)
# Decorative doodads: bases, shops, fountains, lane markers, jungle camp markers, and jungle scenery.
doodad(1, "base", 6500, 30500)
doodad(2, "base", 57500, 30500)
doodad(3, "shop", 3000, 27000)
doodad(4, "shop", 61000, 33000)
doodad(5, "fountain", 7500, 34000)
doodad(6, "fountain", 56500, 26500)
doodad(8, "lane", 16000, 8500)
doodad(9, "lane", 16000, 30500)
doodad(10, "lane", 16000, 52500)
doodad(11, "lane", 48000, 8500)
doodad(12, "lane", 48000, 30500)
doodad(13, "lane", 48000, 52500)
doodad(14, "camp", 20000, 20000)
doodad(15, "camp", 20000, 42000)
doodad(16, "camp", 44000, 20000)
doodad(17, "camp", 44000, 42000)
doodad(18, "rock", 14000, 14000)
doodad(19, "tree", 24000, 16000, rotation=250)
doodad(20, "crystal", 40000, 44000)
doodad(21, "debris", 26000, 46000, rotation=120)
doodad(22, "tree", 38000, 14000, rotation=60)
doodad(23, "rock", 16000, 46000)
doodad(24, "crystal", 50000, 20000)
start(0, 6500, 30500)
start(1, 57500, 30500)
# Bases: structures that spawn creeps on a timer and that the win trigger watches. Side 1's base is its first unit.
spawn("base", 0, 6500, 30500)
spawn("base", 1, 57500, 30500)
# One hero per side and one worker per side.
spawn("hero", 0, 9000, 30500)
spawn("hero", 1, 55000, 30500)
spawn("tender", 0, 9000, 31500)
spawn("tender", 1, 55000, 31500)
# Lane top (y 7..9): a tower per side with hit points, one opening creep per side.
spawn("tower", 0, 16000, 8500)
spawn("tower", 1, 48000, 8500)
spawn("creep", 0, 14000, 8500)
spawn("creep", 1, 50000, 8500)
# Lane middle (y 29..31).
spawn("tower", 0, 16000, 30500)
spawn("tower", 1, 48000, 30500)
spawn("creep", 0, 14000, 30500)
spawn("creep", 1, 50000, 30500)
# Lane bottom (y 51..53).
spawn("tower", 0, 16000, 52500)
spawn("tower", 1, 48000, 52500)
spawn("creep", 0, 14000, 52500)
spawn("creep", 1, 50000, 52500)
# One objective per side in the middle lane, appended last so earlier unit indices hold.
spawn("objective", 0, 26000, 30500)
spawn("objective", 1, 38000, 30500)
