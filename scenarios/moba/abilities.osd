# Ability definitions for the moba scenario. Indices follow declaration order:
# pulse_shot 0, mend_field 1, creep_wave 2. The hero abilities are the engine's own definitions.
ability("pulse_shot", 24, 0, "unit", [effect("damage", p0=6)], target_filters=["ground"], projectile_speed_milli=12000)
ability("mend_field", 96, 50, "point", [effect("heal", p0=12, p1=2000), effect("buff", p0=1, p1=3)])
# Creep wave: three melee creeps (unit 3) and one ranged creep (creep_ranged) per lane, every 30 s (480 ticks, reference wave interval) at the base, offset to the lane's row (p2, milli
# from the base; top -22000, middle 0, bottom +22000). Each creep then marches to the nearest
# enemy building along its lane. Cooldown 480 ticks is the spawn timer.
ability("creep_wave", 480, 0, "none", [effect("spawn", p0=3, p1=0, p2=0, p3=-1696568296), effect("spawn", p0=3, p1=700, p2=0, p3=-1696568296), effect("spawn", p0=3, p1=1400, p2=0, p3=-1696568296), effect("spawn", p0=21, p1=2100, p2=0, p3=-1695518695)])
# Hero abilities appended after creep_wave: cleave_strike 3, dash_step 4, ward_shield 5.
ability("cleave_strike", 36, 0, "unit", [effect("damage", p0=14)], target_filters=["ground"])
ability("dash_step", 120, 0, "point", [effect("move", p0=4000)])
ability("ward_shield", 80, 0, "unit", [effect("shield_bonus", p0=20)], target_filters=["army"])
# reference-style roster (four abilities, then the ultimate, per hero; heroes reference them by name). Mechanics: nuke, projectile,
# AoE, blink, heal-over-time, aura, passive, summon, channel, and the status effects stun, slow, silence, root, invisibility.
# UNVERIFIED: every value below. These heroes are original, and SteamDatabase tracking repo @282fad29f0f74504fad465c52d197fb61f4d612b
# source/scripts/npc/npc_abilities.txt (664 entries) holds no hero ability to copy, so no figure is sourced.
# A passive is a stat ability with cooldown 100000 (never recast) that a spawned behaviour casts once (behaviours.osd). The stat effect is NEW (code 16).
# Ironhide: AoE, passive armor, blink, silence, summon (two creeps).
# Swiftbow: projectile nuke, blink, AoE volley, passive range, channelled AoE ultimate.
# Stormcaller: projectile nuke, AoE, ally shield, stun nuke, AoE ultimate.
# Bulwark: self shield, stun nuke, blink strike, AoE heal, full-life restore ultimate.
# Shadeblade: nuke, blink with invisibility, AoE, silence, blink-strike ultimate.
# Emberlord: projectile, AoE, blink, aura (pulsing heal for 1600 ticks), channelled AoE ultimate.
# Gale archer: projectile nuke, blink, passive damage, slow, AoE ultimate.
# Frostmage: projectile with slow, AoE, ally shield, blink, channelled AoE ultimate.
# Tidecaller: AoE, heal over time (a 160 tick field), ally shield, slow nuke, AoE ultimate.
# Thornwarden: passive health, root nuke, blink, self heal over time, aura ultimate.
# Skill trees for the three character types in declaration order: hero, ironhide, swiftbow.
# Each hero spends one skill point per character level. Four abilities learn up to rank 4; the
# ultimate (slot R, the fifth ability) learns up to rank 3 at levels 6, 12 and 18. Rank 1 of
# damage, cooldown and energy equals the base values above; ranks 2 and up are scaling.
# UNVERIFIED: every rank value below is a design placeholder, not sourced from any game. The
# engine has no passive energy regeneration, so energy costs only matter where the caller grants
# energy (mend_field's base cost is 50; the other abilities cost nothing).
# iron_guard and hawk_eye are passives and carry no skill tree: they cast at spawn, unlearned.
# Damage applies to the ability's first damage or heal effect; ability damage tables for
# abilities without one are 0.
skill("pulse_shot", ultimate=False, gates=[1, 1, 1, 1], damage=[6, 8, 10, 12], cooldown=[24, 22, 20, 18], energy=[0, 0, 0, 0])
skill("mend_field", ultimate=False, gates=[1, 1, 1, 1], damage=[12, 16, 20, 24], cooldown=[96, 90, 84, 78], energy=[50, 55, 60, 65])
skill("cleave_strike", ultimate=False, gates=[1, 1, 1, 1], damage=[14, 18, 22, 26], cooldown=[36, 34, 32, 30], energy=[0, 0, 0, 0])
skill("dash_step", ultimate=False, gates=[1, 1, 1, 1], damage=[0, 0, 0, 0], cooldown=[120, 110, 100, 90], energy=[0, 0, 0, 0])
skill("ward_shield", ultimate=True, gates=[6, 12, 18], damage=[0, 0, 0], cooldown=[80, 70, 60], energy=[0, 0, 0])
# Clinkz per-level cooldowns, in ticks (seconds x 16): Strafe 40/35/30/25, Skeleton Walk 20/19/18/17.
skill("clinkz_strafe", ultimate=False, gates=[1, 1, 1, 1], damage=[0, 0, 0, 0], cooldown=[640, 560, 480, 400], energy=[0, 0, 0, 0])
skill("clinkz_wind_walk", ultimate=False, gates=[1, 1, 1, 1], damage=[0, 0, 0, 0], cooldown=[320, 304, 288, 272], energy=[0, 0, 0, 0])
# Status abilities: stun, slow (half speed), silence, root and invisibility, durations in ticks (16 per second).
ability("stun_bolt", 120, 0, "unit", [effect("damage", p0=10), effect("stun", p0=24)], target_filters=["ground"])
ability("frost_slow", 80, 0, "unit", [effect("slow", p0=48, p1=32768)], target_filters=["ground"])
ability("hex_silence", 100, 0, "unit", [effect("silence", p0=64)], target_filters=["ground"])
ability("entangle", 100, 0, "unit", [effect("root", p0=40)], target_filters=["ground"])
ability("smoke_veil", 160, 0, "none", [effect("invisibility", p0=80)])
# Wards and courier. The cast cooldown is 1 s = 16 ticks (AbilityCooldown 1.0). The ward placement, its unit and lifetime
# (observer 5760 ticks, sentry 6720 ticks: item_ward_observer / item_ward_sentry "lifetime", items.txt
# @282fad29f0f74504fad465c52d197fb61f4d612b) and the charge it spends are the pack's (spells.lua WARDS). The cast has no
# data effect, so it takes hold, and on_cast places the ward.
ability("place_observer", 16, 0, "point", [])
ability("place_sentry", 16, 0, "point", [])
# Glyph of fortification: for 80 ticks (5 s) every friendly structure that is not a building (the towers) takes no damage;
# the team then waits 4800 ticks (300 s). The engine has no glyph effect: protection.lua runs the rule on the cast (on_cast)
# through set_damage_reduction and filter_bits. UNVERIFIED: both numbers are recalled reference ruleset values.
# Filter bits: 64 structure, 2048 building.
ability("glyph_of_fortification", 4800, 0, "none", [])
# Courier: walks to a friendly army unit (a hero), moves its stash into its inventory within 1000 milli, walks back.
ability("courier_deliver", 16, 0, "unit", [effect("carry")], target_filters=["army"])

# Clinkz (6.88g E004 "Bone Fletcher"). First hero abilities sourced from the reference map: values come from
# AbilityData.slk via the LNI tables (see abilities_688g_perlevel.tsv). Cooldowns are per level through the
# skill() rows below; the effect amount and duration have only one value each in this format, so they carry
# level 1. stat index 12 = attack_speed, 19 = speed_pct; both are integer percentages (100 = +100%).
# Strafe A030: DataB[1.3/1.3/1.3/1.3] labelled attack speed increase (%) -> +130. Duration 4 s = 64 ticks.
# UNVERIFIED: the scale of DataB is read as a percentage, so 1.3 -> 130; the archive does not state the unit.
ability("clinkz_strafe", 640, 0, "none", [effect("timed_stat", p0=12, p1=130, p2=64, p3=0)])
# Skeleton Walk / Wind Walk A025: DataB[0.055/0.165/0.275/0.385] labelled move speed increase (%) -> 5.5 / 16.5 /
# 27.5 / 38.5, written rounded to 6 / 17 / 28 / 39 because the stat is a whole number. Duration 20 s = 320 ticks.
# UNVERIFIED: same scale reading, and the rounding of a half percent.
ability("clinkz_wind_walk", 320, 0, "none", [effect("timed_stat", p0=19, p1=6, p2=320, p3=0)])
# Clinkz Death Pact A04Q (E): cooldown 45/35/25 s per level (archive cool_s x 16 ticks); level 1 is 720 ticks.
# UNVERIFIED: its effect, its cost (the archive lists 100 per level, not mapped to energy) and the rank level gates are not sourced.
# So the ability has no effect and no energy cost, and its gates are the engine default of 1.
ability("clinkz_death_pact", 720, 0, "none", [])
skill("clinkz_death_pact", ultimate=False, gates=[1, 1, 1], damage=[0, 0, 0], cooldown=[720, 560, 400], energy=[0, 0, 0])

