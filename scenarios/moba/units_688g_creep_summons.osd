unit("creep_shard_golem", 240, 303, 250, abilities=["creep_mud_golem_spell_damage_reduction"], filters=["ground", "armored", "army"], weapon_damage=9, weapon_range_milli=1563, weapon_period=27, sight_milli=12500, defense=0, model="neutral-mud-golem-skinned", deny_pct=0)
