# Units that neutral creep abilities summon. Stock stats the 6.88g data does not restate are GUESS and named per unit.
# creep_tornado_unit: A ntor Tornado (unit.ini:14780): flying, spd 125 = 122 milli per tick, abilities Atdg (Area 600, DataA 15 a second, DataB 150, DataC 45 a second in the medium radius, ability.ini:7497) and Aasl (-15 percent move and attack speed, ability.ini:4980). GUESS: hit points 200, damage type magical, and the 45 taken as 15 + 30 inside 150.
ability("creep_tornado_wide", 0, 0, "none", [effect("aoe", p0=9375, p1=4, p2=1, p3=0), effect("damage", p0=15, p1=0, p2=2, p3=0)])
ability_ext("creep_tornado_wide", period=16, aura=True)
ability("creep_tornado_core", 0, 0, "none", [effect("aoe", p0=2344, p1=4, p2=1, p3=0), effect("damage", p0=30, p1=0, p2=2, p3=0)])
ability_ext("creep_tornado_core", period=16, aura=True)
ability("creep_tornado_slow", 0, 0, "none", [effect("aoe", p0=9375, p1=4, p2=2, p3=0), effect("timed_stat", p0=19, p1=-15, p2=32, p3=0), effect("timed_stat", p0=12, p1=-15, p2=32, p3=0)])
ability_ext("creep_tornado_slow", period=16, aura=True)
unit("creep_tornado_unit", 200, 122, 250, abilities=["creep_tornado_wide", "creep_tornado_core", "creep_tornado_slow"], filters=["air"], sight_milli=4688, model="pillar-obelisk", deny_pct=0)
unit_extra("creep_tornado_unit", reward=0, xp_reward=0, deny_xp_pct=0)
# creep_raised_skeleton: uske Skeleton Warrior (unit.ini:21044): HP 250, damage 23 + 1d2 (24), period 1.0 s, range 90 = 1406 milli. GUESS: speed 270 = 264 milli per tick, sight, hull.
unit("creep_raised_skeleton", 250, 264, 250, filters=["ground", "armored", "army"], weapon_damage=24, weapon_range_milli=1406, weapon_period=16, sight_milli=12500, defense=0, model="character-skeleton", deny_pct=0)
unit_extra("creep_raised_skeleton", reward=0, xp_reward=0, deny_xp_pct=0)
