# Items for the moba scenario. item(name, cost, armor=, damage=, health=, ability=, components=) declares
# one item: cost in gold, stat bonuses added to the buyer when the item enters the inventory, an
# optional active ability the item casts from its inventory slot, and optional recipe components.
# Active abilities are declared here, after the hero abilities in abilities.osd, so their indices
# follow them. A hero holds six items in the inventory and a stash bank of six; buying needs gold, a
# free slot (the stash takes the overflow), and standing within shop range of a shop doodad (map.osd).
# A recipe names up to two components declared earlier. Buying it consumes the components from the
# inventory, removes their bonuses, and charges cost minus the components' cost. The cost of a recipe
# must be at least the sum of its components' costs. Selling returns half the cost.
# Every cost and stat number below is UNVERIFIED unless its own comment cites a source.
ability("salve_heal", 120, 0, "unit", [effect("heal", p0=30, p1=0)], target_filters=["army"])
ability("blink_step", 200, 0, "point", [effect("move", p0=5000)])
ability("war_cry", 150, 0, "unit", [effect("buff", p0=1, p1=4)], target_filters=["army"])
# UNVERIFIED
item("iron_plate", 150, armor=2)
# UNVERIFIED
item("vitality_ring", 150, health=40)
# UNVERIFIED
item("blade", 200, damage=4)
# UNVERIFIED
item("healing_salve", 120, ability="salve_heal")
# Blink Dagger cost 2250: SteamDatabase/GameTracking-Dota2 @282fad29f0f74504fad465c52d197fb61f4d612b game/dota/pak01_dir/scripts/npc/items.txt, item_blink ItemCost. Blink range 5000 and the other stats stay UNVERIFIED (Dota blink range is 1200).
item("blink_dagger", 2250, ability="blink_step")
# UNVERIFIED
item("war_banner", 300, damage=3, armor=1, ability="war_cry")
# UNVERIFIED
item("cleave_axe", 350, damage=7)
# UNVERIFIED recipe: iron_plate (150) is part of the cost 300
item("iron_mail", 300, armor=4, components=["iron_plate"])
# UNVERIFIED recipe: vitality_ring (150) and healing_salve (120) are part of the cost 350
item("heart_ring", 350, health=80, components=["vitality_ring", "healing_salve"])
# UNVERIFIED recipe: blade (200) and cleave_axe (350) are part of the cost 600
item("battle_fury_axe", 600, damage=12, components=["blade", "cleave_axe"])
# Aegis: the reward a Roshan kill grants its killer. UNVERIFIED: cost 300 is a placeholder.
item("aegis", 300)
