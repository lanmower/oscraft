# Lane waves, siege waves and the wave upgrade rule for the moba scenario.
# Waves spawn from six lane_spawner units (air-layer, immune, no weapon), one per lane per side, placed at each side's melee barracks.
# Spawn p3 bits 30-31 are the lane id of the route the unit follows (1 top, 2 mid, 3 bot); bits 0-29 pack a wave upgrade
# (rust/crates/sim/src/waves.rs): bits 0-9 upgraded unit index + 1, 10-19 final unit index + 1, 20-24 lane tag filter bit + 1, 25-29 global tag
# filter bit + 1. A wave unit spawns as its upgraded kind (super creep) once the enemy barracks of its type that mirrors the spawn point is dead,
# and as its final kind (mega creep) once every enemy barracks is dead. Filter bits: barracks 12, melee_rax 13, ranged_rax 14.
# Which barracks upgrades the siege creep is UNVERIFIED (melee is assumed).
# Wave: 3 melee and 1 ranged creep every 30 s (480 ticks). Siege creeps: the first at 5:00 (4800 ticks) and then every 5:00; a second per lane
# from 30:00 and a third from 60:00 (dotasense.com/guides/siege-creeps, Valve patches 7.06 and 7.41). Each siege ability starts on cooldown
# (initial_cooldown); its ready trigger casts it, and its own cooldown end recasts it every 4800 ticks.
ability("creep_wave_top", 480, 0, "none", [effect("spawn", p0=3, p1=0, p2=0, p3=1524657176), effect("spawn", p0=3, p1=700, p2=0, p3=1524657176), effect("spawn", p0=3, p1=1400, p2=0, p3=1524657176), effect("spawn", p0=21, p1=2100, p2=0, p3=1525706777)])
ability("siege_wave_top", 4800, 0, "none", [effect("spawn", p0=22, p1=0, p2=0, p3=1524659226)], initial_cooldown=4800)
ability("siege_wave_top_30", 4800, 0, "none", [effect("spawn", p0=22, p1=0, p2=0, p3=1524659226)], initial_cooldown=28800)
ability("siege_wave_top_60", 4800, 0, "none", [effect("spawn", p0=22, p1=0, p2=0, p3=1524659226)], initial_cooldown=57600)
behaviour("go_siege_wave_top", trigger="ability_ready", action="use_ability", param=0, ability="siege_wave_top")
behaviour("go_siege_wave_top_30", trigger="ability_ready", action="use_ability", param=0, ability="siege_wave_top_30")
behaviour("go_siege_wave_top_60", trigger="ability_ready", action="use_ability", param=0, ability="siege_wave_top_60")
behaviour("start_creep_wave_top", trigger="spawned", action="use_ability", param=0, ability="creep_wave_top")
behaviour("timer_creep_wave_top", trigger="ability_ready", action="use_ability", param=0, ability="creep_wave_top")
ability("siege_wave_mid", 4800, 0, "none", [effect("spawn", p0=22, p1=0, p2=0, p3=-1696566246)], initial_cooldown=4800)
ability("siege_wave_mid_30", 4800, 0, "none", [effect("spawn", p0=22, p1=0, p2=0, p3=-1696566246)], initial_cooldown=28800)
ability("siege_wave_mid_60", 4800, 0, "none", [effect("spawn", p0=22, p1=0, p2=0, p3=-1696566246)], initial_cooldown=57600)
behaviour("go_siege_wave_mid", trigger="ability_ready", action="use_ability", param=0, ability="siege_wave_mid")
behaviour("go_siege_wave_mid_30", trigger="ability_ready", action="use_ability", param=0, ability="siege_wave_mid_30")
behaviour("go_siege_wave_mid_60", trigger="ability_ready", action="use_ability", param=0, ability="siege_wave_mid_60")
ability("creep_wave_bot", 480, 0, "none", [effect("spawn", p0=3, p1=0, p2=0, p3=-622826472), effect("spawn", p0=3, p1=700, p2=0, p3=-622826472), effect("spawn", p0=3, p1=1400, p2=0, p3=-622826472), effect("spawn", p0=21, p1=2100, p2=0, p3=-621776871)])
ability("siege_wave_bot", 4800, 0, "none", [effect("spawn", p0=22, p1=0, p2=0, p3=-622824422)], initial_cooldown=4800)
ability("siege_wave_bot_30", 4800, 0, "none", [effect("spawn", p0=22, p1=0, p2=0, p3=-622824422)], initial_cooldown=28800)
ability("siege_wave_bot_60", 4800, 0, "none", [effect("spawn", p0=22, p1=0, p2=0, p3=-622824422)], initial_cooldown=57600)
behaviour("go_siege_wave_bot", trigger="ability_ready", action="use_ability", param=0, ability="siege_wave_bot")
behaviour("go_siege_wave_bot_30", trigger="ability_ready", action="use_ability", param=0, ability="siege_wave_bot_30")
behaviour("go_siege_wave_bot_60", trigger="ability_ready", action="use_ability", param=0, ability="siege_wave_bot_60")
behaviour("start_creep_wave_bot", trigger="spawned", action="use_ability", param=0, ability="creep_wave_bot")
behaviour("timer_creep_wave_bot", trigger="ability_ready", action="use_ability", param=0, ability="creep_wave_bot")
spawn("lane_spawner_top", 0, 64500, 222219)
spawn("lane_spawner_mid", 0, 90500, 234625)
spawn("lane_spawner_bot", 0, 96625, 262875)
spawn("lane_spawner_top", 1, 224406, 77625)
spawn("lane_spawner_mid", 1, 236969, 103750)
spawn("lane_spawner_bot", 1, 266500, 110500)
# Tormentor at the Radiant-side spawner of the dump (npc_dota_miniboss_spawner at -7680, 6336 Dota units; it is at the Radiant side first, at night, patch 7.38). The Dire-side spawner and the day/night swap are not modelled.
spawn("tormentor", -1, 43500, 64500)
# Lane routes: the Radiant (player 0) and Dire (player 1) creep paths of each lane (1 top, 2 mid, 3 bot) from npc_dota_spawner_good_* and npc_dota_spawner_bad_* in leamare/dota-map-coordinates data/lanedata.json (Dota units, converted at 15.625 milli per unit and snapped to the nearest walkable cell centre). Lane creeps walk these waypoints, then march on the nearest enemy building.
route(0, 1, [60500, 221500, 64500, 162500, 64500, 119500, 64500, 95500, 67500, 81500, 73500, 75500, 83500, 74500, 93500, 74500, 104500, 73500, 119500, 73500, 133500, 72500, 223500, 73500, 246500, 87500])
route(0, 2, [87500, 231500, 115500, 206500, 146500, 174500, 156500, 166500, 165500, 161500, 177500, 153500, 200500, 134500, 233500, 101500, 246500, 88500])
route(0, 3, [97500, 259500, 171500, 267500, 195500, 262500, 214500, 258500, 224500, 257500, 235500, 255500, 251500, 253500, 256500, 248500, 261500, 235500, 261500, 218500, 262500, 111500, 247500, 88500])
route(1, 1, [223500, 73500, 133500, 72500, 81500, 76500, 73500, 80500, 69500, 87500, 66500, 102500, 60500, 221500, 76500, 242500])
route(1, 2, [233500, 101500, 200500, 133500, 177500, 153500, 164500, 160500, 156500, 166500, 146500, 174500, 87500, 231500, 77500, 242500])
route(1, 3, [262500, 111500, 259500, 156500, 258500, 211500, 260500, 223500, 259500, 243500, 250500, 253500, 242500, 255500, 180500, 262500, 97500, 258500, 77500, 243500])
# Boss pits from the dump (npc_dota_roshan_spawner and npc_dota_miniboss_spawner, converted at 15.625 milli per Dota unit): Roshan starts in the bottom pit, the day pit, and from 15:00 stands in the top pit at night and the bottom pit by day; the Tormentor spawns at the Radiant corner at night and the Dire corner by day (Valve patch 7.38).
spawn("roshan_pit_night", -1, 113589, 126084)
spawn("roshan_pit_day", -1, 207734, 206312)
spawn("tormentor_spawn_night", -1, 43500, 64500)
spawn("tormentor_spawn_day", -1, 284500, 260500)
