# Units for the moba scenario. One unit(...) call per line. Declaration order sets unit indices:
# hero 0, tower 1, base 2, creep 3, tender 4.
unit("hero", 300, 2800, 500, build_time=480, resource_a=0, capacity=1, abilities=["pulse_shot", "mend_field"], filters=["ground", "armored", "army"], weapon_damage=12, weapon_range_milli=5000, weapon_period=24, sight_milli=9000, shield=0, armor=1)
unit("tower", 400, 1000, 600, filters=["ground", "armored", "massive", "structure"], weapon_damage=12, weapon_range_milli=6000, weapon_period=24, sight_milli=8000)
unit("base", 1500, 1000, 1000, filters=["ground", "armored", "massive", "structure", "building"], abilities=["creep_wave"], sight_milli=8000)
unit("creep", 60, 2000, 350, build_time=240, filters=["ground", "light", "army"], weapon_damage=4, weapon_range_milli=4000, weapon_period=24, sight_milli=7000)
unit("tender", 40, 2800, 350, build_time=300, resource_a=50, capacity=1, filters=["ground", "light", "worker"], sight_milli=8000, resource="resource_a", harvest=5)
