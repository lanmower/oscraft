# Units for the moba scenario. One unit(...) call per line. Declaration order sets unit indices:
# hero 0, tower 1, base 2, creep 3, tender 4, objective 5, then the Dota-style heroes 6 to 15 (five per side
# in the lobby pool). Heroes append after the base units so existing indices do not move. model names a file in js/client/models.
unit("hero", 300, 2800, 500, deny_pct=25,build_time=480, resource_a=0, capacity=1, abilities=["pulse_shot", "mend_field", "cleave_strike", "dash_step", "ward_shield"], filters=["ground", "armored", "army"], weapon_damage=12, weapon_range_milli=5000, weapon_period=24, sight_milli=9000, shield=0, armor=1, model="character-male-a")
# Tower (health 1800, armor 12, damage 88-92 -> 90): source SteamDatabase/GameTracking-Dota2 @282fad29f0f74504fad465c52d197fb61f4d612b game/dota/pak01_dir/scripts/npc/npc_units.txt, npc_dota_badguys_tower1_mid. Range, speed, sight, deny_pct stay UNVERIFIED (sim scale differs from Dota units).
unit("tower", 1800, 1000, 600, filters=["ground", "armored", "massive", "structure"], weapon_damage=90, weapon_range_milli=6000, weapon_period=40, sight_milli=8000, armor=12, model="tower-square", deny_pct=10)
# Base: UNVERIFIED. Sourced Ancient values (npc_dota_badguys_fort, StatusHealth line 5622 health 4500, ArmorPhysical line 5578 armor 23, SteamDatabase/GameTracking-Dota2 @282fad29f0f74504fad465c52d197fb61f4d612b) were tried and reverted: with them the siege check ("side 0 wins within 2400 ticks") fails in CI.
unit("base", 1500, 1000, 1000, filters=["ground", "armored", "massive", "structure", "building"], abilities=["creep_wave", "glyph_of_fortification"], sight_milli=8000, model="building-f", deny_pct=0)
# Creep (health 550, armor 2, damage 19-23 -> 21): SteamDatabase/GameTracking-Dota2 @282fad29f0f74504fad465c52d197fb61f4d612b game/dota/pak01_dir/scripts/npc/npc_units.txt, npc_dota_creep_badguys_melee (StatusHealth line 839, ArmorPhysical line 793, AttackDamageMin/Max lines 799-800). Source speed 325, attack range 100 and acquisition 500 are in Dota units; the sim milli scale is not established, so speed, radius, range and sight stay UNVERIFIED. deny_pct has no source key: UNVERIFIED.
unit("creep", 550, 2000, 350, build_time=240, filters=["ground", "light", "army"], weapon_damage=21, weapon_range_milli=1000, weapon_period=30, sight_milli=7000, armor=2, model="character-skeleton", deny_pct=50)
unit("tender", 40, 2800, 350, deny_pct=50,build_time=300, resource_a=50, capacity=1, filters=["ground", "light", "worker"], sight_milli=8000, resource="resource_a", harvest=5, model="character-female-a")
unit("objective", 800, 1000, 900, filters=["ground", "armored", "massive", "structure"], sight_milli=6000, model="pillar-obelisk", deny_pct=50)
