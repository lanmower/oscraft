# Units for the moba scenario. One unit(...) call per line. Declaration order sets unit indices:
# hero 0, tower 1, base 2, creep 3, tender 4, objective 5, then the reference-style heroes 6 to 15 (five per side
# in the lobby pool). Heroes append after the base units so existing indices do not move. model names a file in scenarios/moba/assets/models.
unit("hero", 120, 303, 375, deny_pct=25,build_time=480, resource_a=0, capacity=1, abilities=["pulse_shot", "mend_field", "cleave_strike", "dash_step", "ward_shield"], filters=["ground", "armored", "army"], weapon_damage=37, weapon_range_milli=2344, weapon_period=26, sight_milli=28125, shield=0, defense=0, model="")
# Tower (T1): npc_units.txt @282fad29f0f74504fad465c52d197fb61f4d612b badguys_tower1_mid (StatusHealth 1800, ArmorPhysical 12, damage 88-92 midpoint 90, range 700, AttackRate 0.9 x 100 / BaseAttackSpeed 110 = 13 ticks, vision 1900). Scale: 1 reference unit = 15.625 milli. deny_pct 10 is the reference tower deny rule, not in the dump.
unit("tower", 1800, 0, 2250, filters=["ground", "armored", "massive", "structure"], weapon_damage=90, weapon_range_milli=10938, weapon_period=13, sight_milli=29688, defense=12, model="tower-square-top-roof", deny_pct=10)
# Base (Ancient): npc_units.txt @282fad29f0f74504fad465c52d197fb61f4d612b badguys_fort (StatusHealth 4500, StatusHealthRegen 12, ArmorPhysical 23, vision 2600). The ancient does not attack.
unit("base", 4500, 0, 2250, filters=["ground", "armored", "massive", "structure", "building"], abilities=["glyph_of_fortification"], sight_milli=40625, defense=23, health_regen=750, model="building-b", deny_pct=0)
# Melee lane creep: npc_units.txt @282fad29f0f74504fad465c52d197fb61f4d612b creep_badguys_melee (health 550, regen 0.5, armor 2, damage 19-23 midpoint 21, range 100, rate 1.0 s, speed 325, vision 750, ring radius 45).
unit("creep", 550, 317, 250, filters=["ground", "light", "army"], weapon_damage=21, weapon_range_milli=1562, weapon_period=16, sight_milli=11719, defense=2, health_regen=31, model="character-skeleton", deny_pct=50)
unit("tender", 40, 2800, 350, deny_pct=50,build_time=300, resource_a=50, capacity=1, filters=["ground", "light", "worker"], sight_milli=8000, resource="resource_a", harvest=5, model="character-female-a")
unit("objective", 800, 1000, 900, filters=["ground", "armored", "massive", "structure"], sight_milli=6000, model="pillar-obelisk", deny_pct=50)
# Roshan: npc_units.txt @282fad29f0f74504fad465c52d197fb61f4d612b roshan (health 6000, regen 20, armor 30, damage 75, rate 2.0 s, range 150, speed 270, vision 1400, ring radius 110). Magic resistance 55 and his abilities are not modelled. Appended late so unit indices hold.
unit("roshan", 7500, 264, 375, filters=["ground", "armored", "massive"], weapon_damage=75, weapon_range_milli=3125, weapon_period=16, sight_milli=21875, defense=6, health_regen=1250, model="roshan-skinned", deny_pct=0)
# Bounty rune: a 1-hp pickup at a river point, no weapon. The rune is a game object, not a unit, in reference: health 1, radius 300 and model are placeholders.
unit("bounty_rune", 1, 0, 300, filters=["ground"], sight_milli=0, model="coin", deny_pct=0)
# Observer ward: StatusHealth 100, VisionDaytimeRange 1600 x 15.625 = 25000 milli (observer_wards, npc_units.txt @282fad29f0f74504fad465c52d197fb61f4d612b).
unit("observer_ward", 100, 0, 200, filters=["ground", "light"], sight_milli=25000, model="candle", deny_pct=0)
# Sentry ward: StatusHealth 100, vision 0; true sight 1050 x 15.625 = 16406 milli (item_ward_sentry true_sight_range in items.txt, npc_units.txt @282fad29f0f74504fad465c52d197fb61f4d612b). Health is the observer value: sentry_wards carries the same 100.
unit("sentry_ward", 100, 0, 200, filters=["ground", "light"], sight_milli=0, model="candle-multiple", deny_pct=0)
# Courier: StatusHealth 6, BountyGold 35, MovementSpeed 290 (courier, npc_units.txt @282fad29f0f74504fad465c52d197fb61f4d612b), VisionDaytimeRange 200. Speed 290 x 15.625 / 16 = 283 milli per tick; sight 200 x 15.625 = 3125.
unit("courier", 6, 283, 375, abilities=["courier_deliver"], filters=["ground", "light"], sight_milli=3125, model="character-human", deny_pct=0)
