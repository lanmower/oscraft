# Units for the moba scenario. One unit(...) call per line. Declaration order sets unit indices:
# hero 0, tower 1, base 2, creep 3, tender 4, objective 5, then the Dota-style heroes 6 to 15 (five per side
# in the lobby pool). Heroes append after the base units so existing indices do not move. model names a file in js/client/models.
unit("hero", 300, 2800, 500, deny_pct=25,build_time=480, resource_a=0, capacity=1, abilities=["pulse_shot", "mend_field", "cleave_strike", "dash_step", "ward_shield"], filters=["ground", "armored", "army"], weapon_damage=12, weapon_range_milli=5000, weapon_period=24, sight_milli=9000, shield=0, armor=1, model="character-male-a")
unit("tower", 1400, 1000, 600, filters=["ground", "armored", "massive", "structure"], weapon_damage=40, weapon_range_milli=6000, weapon_period=40, sight_milli=8000, armor=4, model="tower-square", deny_pct=10)
unit("base", 1500, 1000, 1000, filters=["ground", "armored", "massive", "structure", "building"], abilities=["creep_wave"], sight_milli=8000, model="building-f", deny_pct=50)
unit("creep", 550, 2000, 350, build_time=240, filters=["ground", "light", "army"], weapon_damage=21, weapon_range_milli=1000, weapon_period=30, sight_milli=7000, armor=2, model="character-skeleton", deny_pct=50)
unit("tender", 40, 2800, 350, deny_pct=50,build_time=300, resource_a=50, capacity=1, filters=["ground", "light", "worker"], sight_milli=8000, resource="resource_a", harvest=5, model="character-female-a")
unit("objective", 800, 1000, 900, filters=["ground", "armored", "massive", "structure"], sight_milli=6000, model="pillar-obelisk", deny_pct=50)
unit("ironhide", 340, 2700, 500, deny_pct=25,build_time=480, resource_a=0, capacity=1, abilities=["iron_slam", "iron_guard", "iron_charge", "iron_roar", "iron_titan"], filters=["ground", "armored", "army"], weapon_damage=16, weapon_range_milli=1500, weapon_period=24, sight_milli=9000, shield=0, armor=2, model="character-male-a")
unit("swiftbow", 280, 2900, 500, deny_pct=25,build_time=480, resource_a=0, capacity=1, abilities=["swift_arrow", "evade_step", "piercing_volley", "hawk_eye", "storm_rain"], filters=["ground", "armored", "army"], weapon_damage=14, weapon_range_milli=5500, weapon_period=24, sight_milli=9000, shield=0, armor=1, model="character-female-a")
unit("stormcaller", 260, 2600, 500, deny_pct=25,build_time=480, resource_a=0, capacity=1, abilities=["spark_bolt", "frost_nova", "wind_shield", "chain_storm", "storm_sky"], filters=["ground", "armored", "army"], weapon_damage=12, weapon_range_milli=5000, weapon_period=24, sight_milli=9000, shield=0, armor=1, model="character-male-a")
unit("bulwark", 360, 2600, 500, deny_pct=25,build_time=480, resource_a=0, capacity=1, abilities=["bulwark_stance", "taunt_cry", "crush_step", "bastion_mend", "last_wall"], filters=["ground", "armored", "army"], weapon_damage=14, weapon_range_milli=1500, weapon_period=24, sight_milli=9000, shield=0, armor=3, model="character-male-a")
unit("shadeblade", 290, 3000, 500, deny_pct=25,build_time=480, resource_a=0, capacity=1, abilities=["shade_strike", "smoke_step", "blade_dance", "shadow_mark", "death_glide"], filters=["ground", "armored", "army"], weapon_damage=18, weapon_range_milli=1500, weapon_period=24, sight_milli=9000, shield=0, armor=1, model="character-female-a")
unit("emberlord", 300, 2700, 500, deny_pct=25,build_time=480, resource_a=0, capacity=1, abilities=["ember_bolt", "ember_wave", "flame_leap", "kindle_aura", "inferno_storm"], filters=["ground", "armored", "army"], weapon_damage=14, weapon_range_milli=4500, weapon_period=24, sight_milli=9000, shield=0, armor=1, model="character-male-a")
unit("gale_archer", 280, 2800, 500, deny_pct=25,build_time=480, resource_a=0, capacity=1, abilities=["gale_shot", "gust_step", "rapid_fire", "gale_mark", "hurricane"], filters=["ground", "armored", "army"], weapon_damage=16, weapon_range_milli=5500, weapon_period=24, sight_milli=9000, shield=0, armor=1, model="character-female-a")
unit("frostmage", 270, 2600, 500, deny_pct=25,build_time=480, resource_a=0, capacity=1, abilities=["frost_bolt", "ice_ring", "frost_shield", "arcane_lift", "glacial_storm"], filters=["ground", "armored", "army"], weapon_damage=12, weapon_range_milli=5000, weapon_period=24, sight_milli=9000, shield=0, armor=1, model="character-male-a")
unit("tidecaller", 300, 2700, 500, deny_pct=25,build_time=480, resource_a=0, capacity=1, abilities=["tide_wave", "tide_mend", "tide_ward", "undertow", "tsunami"], filters=["ground", "armored", "army"], weapon_damage=13, weapon_range_milli=4000, weapon_period=24, sight_milli=9000, shield=0, armor=2, model="character-female-a")
