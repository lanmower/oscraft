unit("warden", 120, 2250, 500, build_time=720, minerals=100, supply=3, abilities=["pulse_shot"], filters=["ground", "armored", "massive", "army"], weapon_damage=10, weapon_range_milli=6000, weapon_period=36, sight_milli=10000, shield=40, armor=1, damage_response="reduced")
