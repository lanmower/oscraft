# Behaviour definitions for the duel-routes scenario. behaviour(name, trigger, action, param=, ability=)
behaviour("guard_patrol", trigger="idle", action="use_ability", param=0, ability="pulse_shot")
behaviour("answer_attack", trigger="attacked", action="attack_nearest", param=0)
# A side wins once every structure it carries is destroyed.
behaviour("side_structures_lost", trigger="destroyed", action="declare_winner", tag="structure")
