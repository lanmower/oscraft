# <<< plugkit managed

# gm's own session state is local, not source.
.gm/

# Downloaded archives and extracted map bodies are third-party data pulled
# during a run, not source.
testdata/_incoming/
testdata/extract*/
# DocumentHeader bytes extracted out of real maps. third-party data, like the maps
# themselves, and the reader is already verified against the committed
# fixtures -- so it stays out of the tree rather than quietly contradicting
# the provenance note in the README.
testdata/dh/
# Exclude the CONTENTS of the map directory, not the directory itself. git
# cannot re-include a file whose parent directory is excluded, so ignoring
# "testdata/maps/" makes every "!testdata/maps/*.map" negation below dead --
# which is how the CI coverage gate ended up vacuous on a clean checkout.
testdata/maps/*

# The small fixtures the reader and the coverage gate are verified against.
# About 92 KB in total.
!testdata/maps/Banshee2vsMarine8.map
!testdata/maps/CollectMineralShards.map
!testdata/maps/ResourcesHaveArrived.map

# Witness captures from a run; the hash is what the PRD log binds to.
testdata/*.txt

# Python leaves these beside the probe scripts under tools/.
__pycache__/
*.pyc

# Built wasm modules and binaries.
*.wasm
build/
*.exe
# Page build output: CI and Pages rebuild these from source.
/js/client/pkg/
/js/client/map.bin
/js/client/moba.bin
/rust/crates/web/site/pkg/
/rust/crates/web/site/map.bin
/rust/crates/web/site/moba.bin
