# Economy for the map. economy(...) runs once. Saturation counts must be at least 1.
economy(
    patch_saturation=3,
    gas_saturation=3,
    patches_per_base=8,
    geysers_per_base=2,
    extractor_yield=4,
    opening_minerals=0,
    opening_gas=0,
    opening_workers=4,
    supply_base=20,
    supply_max=200,
    patch_yield=1500,
    geyser_yield=2500,
)
