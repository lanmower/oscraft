# RPG map: 24x24 grid, one start, quest giver and wolves as neutral units. grid() runs once.
grid(24, 24, cell_milli=1000)
paint(0, 0, 24, 1, 1)
paint(0, 23, 24, 24, 1)
paint(0, 0, 1, 24, 1)
paint(23, 0, 24, 24, 1)
paint(8, 8, 10, 10, 2)
limit(per_cell=4)
height_step(500)
paint_height(0, 0, 24, 24, 1)
paint_tile(0, 0, 24, 24, 1)
paint_tile(8, 8, 10, 10, 2)
doodad(1, "tree", 6000, 6000, rotation=90)
doodad(2, "rock", 15000, 9000)
start(0, 3000, 3000)
spawn("adventurer", 0, 3000, 3000)
spawn("quest_giver", -1, 12000, 12000)
spawn("wolf", -1, 9000, 10000)
spawn("wolf", -1, 15000, 14000)
