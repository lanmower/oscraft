# MOBA map: 40x40 grid, two lanes with walls and gaps, towers, neutral objective. grid() runs once.
grid(40, 40, cell_milli=1000)
paint(0, 0, 40, 1, 1)
paint(0, 39, 40, 40, 1)
paint(0, 0, 1, 40, 1)
paint(39, 0, 40, 40, 1)
paint(2, 12, 30, 13, 1)
paint(10, 27, 38, 28, 1)
limit(per_cell=4)
height_step(500)
paint_height(0, 0, 40, 40, 1)
paint_height(18, 18, 22, 22, 3)
paint_tile(0, 0, 40, 40, 1)
paint_tile(2, 14, 38, 26, 2)
doodad(1, "rock", 3000, 3000)
doodad(2, "tree", 33000, 7000, rotation=120)
start(0, 4000, 4000)
start(1, 36000, 36000)
spawn("hero", 0, 4000, 4000)
spawn("hero", 1, 36000, 36000)
spawn("tower", 0, 10000, 15000)
spawn("tower", 0, 16000, 8000)
spawn("tower", 1, 30000, 25000)
spawn("tower", 1, 24000, 32000)
spawn("objective", -1, 20000, 20000)
spawn("creep", -1, 14000, 20000)
spawn("creep", -1, 26000, 20000)
