# Extra fields for the moba scenario. unit_extra(name, ...) sets them for one unit.
# Verified from the reference deny rules: a denied lane creep gives enemies 50% xp, a denied hero gives 0%,
# and a denied unit pays no gold. Heroes are player_controlled; they share kill and assist xp.
# Every other value below is UNVERIFIED unless its own comment cites a source.
# Bounties from SteamDatabase tracking repo @282fad29f0f74504fad465c52d197fb61f4d612b source/scripts/npc/npc_units.txt. Creep: BountyGoldMin 34 / Max 39 -> 36, BountyXP 57. Tower: no bounty keys in badguys_tower1_mid, so gold and xp are 0. Roshan: BountyGoldMin 200 / Max 290 -> 245, BountyXP 400. Gold ranges are reduced to their midpoint because the sim takes one value.
unit_extra("creep", reward=36, xp_reward=57, deny_xp_pct=50, assist_radius_milli=23438, acquire=500)
unit_extra("tower", reward=0, xp_reward=0, deny_xp_pct=0)  # no bounty keys in the dump
unit_extra("base", deny_xp_pct=0)  # UNVERIFIED: placeholder, not in the verified rules
unit_extra("objective", deny_xp_pct=0)  # UNVERIFIED: placeholder, not in the verified rules
unit_extra("tender", deny_xp_pct=0)  # UNVERIFIED: placeholder, not in the verified rules
unit_extra("hero", player_controlled=True, deny_xp_pct=0)
# Roshan bounty: 6.88g [n00L] bountydice 5, bountysides 51, bountyplus 145 = 5d51+145, mean 275 gold (range 150-400; the engine takes one value). 400 xp, source as above. assist_radius_milli UNVERIFIED.
unit_extra("roshan", reward=275, xp_reward=400, assist_radius_milli=23438)
# Wards: bounty 100 gold and 100 xp from observer_wards (sentry copies it, UNVERIFIED). Sentry detector radius 1050 x 15.625 = 16406 milli (item_ward_sentry true_sight_range).
unit_extra("observer_ward", reward=100, xp_reward=100, deny_xp_pct=0)
unit_extra("sentry_ward", reward=100, xp_reward=100, deny_xp_pct=0, detector_radius=16406)
# Courier bounty 35 gold: courier BountyGoldMin/Max.
unit_extra("courier", reward=35, xp_reward=0, deny_xp_pct=0)
