# Economy for the moba scenario. economy(...) runs once. Saturation counts must be at least 1.
# resource_a is the gold of this match.
economy(
    patch_saturation=3,
    gas_saturation=3,
    patches_per_base=0,
    geysers_per_base=0,
    extractor_yield=4,
    # The gold a seat opens with, so the shop is usable before the first last hit: without it a hero
    # stands at its fountain with nothing to spend and the opening item choices never happen.
    # UNVERIFIED: the reference starting gold, recalled rather than read from a dump in this repo.
    opening_resource_a=625,
    opening_gas=0,
    opening_workers=0,
    capacity_base=20,
    capacity_max=200,
    patch_yield=1500,
    geyser_yield=2500,
)
