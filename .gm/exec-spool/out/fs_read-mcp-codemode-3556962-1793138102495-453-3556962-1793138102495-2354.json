{"data":{"clamped_to_total_lines":true,"content":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <link rel=\"icon\" href=\"data:,\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>oscraft map editor</title>\n  <style>\n    html, body { margin: 0; height: 100%; background: #1d252c; color: #d8e0e6; font: 13px system-ui, sans-serif; overflow: hidden; }\n    canvas { display: block; width: 100vw; height: 100vh; }\n    #panel { position: fixed; left: 8px; top: 8px; width: 230px; padding: 8px; background: rgba(0, 0, 0, 0.6); border-radius: 4px; }\n    #panel label { display: block; margin: 4px 0; }\n    #panel input, #panel select, #panel button { width: 100%; box-sizing: border-box; }\n    #panel input[type=number] { width: 70px; }\n    #status { margin-top: 6px; white-space: pre-wrap; }\n    #osd { position: fixed; right: 8px; bottom: 8px; width: 360px; height: 160px; font: 11px monospace; }\n  </style>\n</head>\n<body>\n  <canvas id=\"view\"></canvas>\n  <div id=\"panel\">\n    <a href=\"play.html\">play</a>\n    <label>map.bin <input id=\"open\" type=\"file\" accept=\".bin\"></label>\n    <label>new map <input id=\"new-w\" type=\"number\" value=\"32\" min=\"1\"> x <input id=\"new-h\" type=\"number\" value=\"32\" min=\"1\"> <button id=\"new\" type=\"button\">new</button></label>\n    <label>tool\n      <select id=\"tool\">\n        <option value=\"paint\">paint cell kind</option>\n        <option value=\"height\">paint height</option>\n        <option value=\"prop\">place prop</option>\n        <option value=\"spawn\">place unit spawn</option>\n        <option value=\"delete\">delete prop / spawn</option>\n        <option value=\"region\">region (two corners)</option>\n      </select>\n    </label>\n    <label>cell kind <select id=\"kind\"></select></label>\n    <label>height level <input id=\"level\" type=\"number\" value=\"1\" min=\"0\" max=\"255\"></label>\n    <label>brush radius <input id=\"radius\" type=\"number\" value=\"1\" min=\"0\" max=\"8\"></label>\n    <label>prop kind <select id=\"prop-kind\"></select></label>\n    <label>unit <input id=\"unit\" value=\"skirmisher\"></label>\n    <label>player (-1 neutral) <input id=\"player\" type=\"number\" value=\"0\" min=\"-1\" max=\"15\"></label>\n    <label>region name <input id=\"region-name\" value=\"region\"></label>\n    <button id=\"export\" type=\"button\">export map.osd</button>\n    <div id=\"status\">loading</div>\n    <div>left: apply, right drag: orbit, shift or middle drag: pan, wheel: zoom</div>\n  </div>\n  <textarea id=\"osd\" readonly placeholder=\"exported map.osd\"></textarea>\n  <script type=\"module\" src=\"editor.js\"></script>\n</body>\n</html>","end_line":49,"end_line_requested":400,"has_more_lines":false,"offset":0,"path":"js/client/editor.html","range_basis":"1-based, inclusive on both ends","returned_lines":49,"start_line":1,"total_lines":49,"truncated_at_bytes":false},"dispatch_id":"1793138102584-4450-6d6b27d7b0dd0151","gm_session_header_version":1,"ok":true,"request_fingerprint":"c2dcaa256871f7f5","verb":"fs_read"}